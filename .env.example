# Copie este arquivo para .env e ajuste os valores.

PORT=3000

# Interface de rede. Vazio = todas (bom para testar no celular pela rede local).
# Em produção atrás do Caddy/Cloudflare Tunnel use 127.0.0.1 (o install.sh já faz isso).
HOST=

# true quando roda atrás de um proxy (Caddy, Cloudflare Tunnel): usa o IP real do
# visitante do cabeçalho X-Forwarded-For. Deixe false se o Node estiver exposto direto.
TRUST_PROXY=false

# URL pública do sistema (usada nos QR Codes). Ex.: https://checkin.okay.com.br
# Se vazio, usa o endereço pelo qual o painel admin foi acessado.
PUBLIC_URL=

# Segredo que assina os QR Codes. Se vazio, um segredo é gerado em data/secret.txt
QR_SECRET=

# Acesso ao painel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
