# Copie este arquivo para .env e ajuste os valores.

PORT=3000

# URL pública do sistema (usada nos QR Codes). Ex.: https://checkin.okay.com.br
# Se vazio, usa o endereço pelo qual o painel admin foi acessado.
PUBLIC_URL=

# Segredo que assina os QR Codes. Se vazio, um segredo é gerado em data/secret.txt
QR_SECRET=

# Acesso ao painel /admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------
# Consulta de CPF
#   mock   -> nomes fictícios (só para desenvolvimento)
#   serpro -> API oficial Consulta CPF do SERPRO (base da Receita Federal)
#   custom -> qualquer provedor HTTP (Didit, Direct Data, Infosimples...)
# ---------------------------------------------------------------
CPF_PROVIDER=mock

# SERPRO: SERPRO_TRIAL=true usa o ambiente de demonstração gratuito
# (só responde aos CPFs de teste da documentação do SERPRO).
SERPRO_TRIAL=true
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=

# Provedor custom: {cpf} é substituído pelo CPF (só números)
CPF_API_URL=
CPF_API_METHOD=GET
# Cabeçalhos em JSON, ex.: {"Authorization":"Bearer SEU_TOKEN"}
CPF_API_HEADERS={}
# Caminho do nome na resposta JSON, ex.: data.nome
CPF_API_NAME_PATH=nome

# Se a consulta falhar (API fora do ar), permitir digitar o nome manualmente?
ALLOW_MANUAL_NAME=false
